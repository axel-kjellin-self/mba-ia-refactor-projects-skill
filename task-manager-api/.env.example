# Copie para .env e preencha. NUNCA versione o .env.

# Obrigatório. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Ambiente: development | production | testing
FLASK_ENV=development
FLASK_DEBUG=false

# Servidor
HOST=127.0.0.1
PORT=5000

# Banco de dados
DATABASE_URL=sqlite:///tasks.db

# JWT
JWT_EXPIRES_SECONDS=3600

# CORS — origens permitidas, separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# SMTP (notificações). Deixe SMTP_ENABLED=false para desativar o envio.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Logging
LOG_LEVEL=INFO

# Senha usada pelo seed.py (mínimo 12 caracteres, com maiúscula, minúscula e número)
SEED_PASSWORD=
