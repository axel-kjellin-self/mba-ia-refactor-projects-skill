# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (if using external DB in future)
DB_USER=admin_master
DB_PASSWORD=your-database-password-here

# Payment Gateway
PAYMENT_GATEWAY_KEY=your-payment-gateway-key-here

# SMTP Configuration
SMTP_USER=no-reply@yourdomain.com

# JWT Authentication
JWT_SECRET=your-jwt-secret-key-min-32-chars-here
JWT_EXPIRES_IN=24h
