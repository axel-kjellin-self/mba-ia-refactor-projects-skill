# Copie para .env e preencha com valores reais. NUNCA commite o .env.

NODE_ENV=development
PORT=3000

# Banco de dados. ":memory:" usa SQLite em memória (dados perdidos no restart).
DATABASE_FILE=:memory:

# Segredo usado para assinar os JWT. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres
JWT_EXPIRES_IN=1h

# Credenciais do gateway de pagamento (rotacione se já vazaram).
PAYMENT_GATEWAY_KEY=pk_test_sua_chave_aqui

# SMTP
SMTP_USER=no-reply@example.com

# Usuário administrador criado no seed (apenas ambiente de desenvolvimento).
SEED_ADMIN_EMAIL=admin@fullcycle.com.br
SEED_ADMIN_PASSWORD=troque-esta-senha-local
