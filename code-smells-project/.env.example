# Copie para .env e preencha. O arquivo .env NÃO deve ser versionado.

# Chave de assinatura dos tokens JWT. Mínimo de 32 caracteres.
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# development | production
FLASK_ENV=development
DEBUG=true

# Caminho do arquivo SQLite
DATABASE_PATH=loja.db

# Validade do token de acesso, em segundos (padrão: 1 hora)
JWT_EXPIRES_SECONDS=3600

# Origens permitidas para CORS, separadas por vírgula.
# Não use "*" em produção.
CORS_ORIGINS=http://localhost:3000

# Servidor de desenvolvimento
HOST=127.0.0.1
PORT=5000

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Carga de dados de exemplo (desabilite em produção)
SEED_DATA=true
# Senha do admin de exemplo. Sem este valor, nenhum usuário é criado no seed.
SEED_ADMIN_PASSWORD=
