# Copie para .env e ajuste os valores. NUNCA versione o .env.

# Chave usada para assinar os tokens JWT. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-antes-de-subir

# development | production
FLASK_ENV=development
DEBUG=false

HOST=127.0.0.1
PORT=5000

DATABASE_PATH=loja.db

# Tempo de vida do token de acesso, em minutos
JWT_EXPIRATION_MINUTES=60

# Origens permitidas no CORS (separadas por vírgula, ou * para liberar tudo)
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

# Credenciais do admin criado no seed inicial (apenas ambiente de desenvolvimento).
# Se não forem definidas, nenhum usuário é criado automaticamente.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
